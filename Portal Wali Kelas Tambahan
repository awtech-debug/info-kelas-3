  const sampleStudent = state.students[0];
  const sampleRaw = target === 'asas'
    ? state.scores[mp][sampleStudent].asas
    : (state.scores[mp][sampleStudent].tugas.find(v => v !== null) ?? 75);
  const sampleAfter = computeKatrolValue(sampleRaw, method, param, avgCurr);

  const box = document.getElementById('katrolPreviewBox');
  box.classList.remove('hidden');
  box.innerHTML = `Simulasi <strong>${mp}</strong> (Rata-rata saat ini: <strong>${avgCurr.toFixed(1)}</strong>): Contoh nilai <strong>${sampleRaw}</strong> → menjadi <strong>${sampleAfter}</strong> (maksimal 100, minimal KKTP ${state.kktp}).`;
}

function applyKatrol() {
  const mp = document.getElementById('nilaiMapelSelect').value;
  const target = document.getElementById('katrolTarget').value;
  const method = document.getElementById('katrolMethod').value;
  const param = Number(document.getElementById('katrolValue').value) || 0;
