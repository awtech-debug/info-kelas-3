<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Info Kelas 3 - Portal Admin &amp; Wali Kelas (MIM 1 Slinga)</title>
<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mammoth@1.6.0/mammoth.browser.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
  body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f1f5f9; }
  .tab-btn.active { background-color: #0f766e; color: #ffffff; box-shadow: 0 2px 6px rgba(15,118,110,0.25); }
  .subtab-btn.active { background-color: #1e293b; color: #ffffff; }
  @media print {
    .no-print { display: none !important; }
    body { background-color: #ffffff; }
    .print-container { box-shadow: none !important; border: none !important; padding: 0 !important; }
  }
  .custom-scroll::-webkit-scrollbar { height: 8px; width: 8px; }
  .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  .custom-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
</style>
</head>
<body class="text-slate-800 antialiased">

<!-- Top Header / Portal Info Kelas 3 -->
<header class="bg-teal-900 text-white shadow-md no-print">
  <div class="max-w-[1440px] mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-teal-700 flex items-center justify-center text-amber-300 font-extrabold text-lg shadow">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-lg md:text-xl font-extrabold tracking-tight">Info Kelas 3 — Portal Admin &amp; Wali Kelas</h1>
          <span class="text-xs bg-teal-800 text-teal-200 px-2 py-0.5 rounded-full border border-teal-700">Kurikulum Merdeka</span>
        </div>
        <p class="text-xs text-teal-200">Manajemen Nilai, Legger, KKTP &amp; Katrol, Kalender Pendidikan, Perangkat Ajar AI &amp; Analisis Butir Soal (26 Siswa)</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-xs">
      <div class="bg-teal-800/90 px-3 py-1.5 rounded-lg border border-teal-700 flex items-center gap-2">
        <span class="text-teal-300 font-semibold">KKTP / KKM:</span>
        <input id="globalKktpInput" type="number" min="1" max="100" value="70" onchange="updateGlobalKktp(this.value)"
          class="w-14 bg-teal-950 text-amber-300 font-bold text-center rounded border border-teal-600 py-0.5 focus:outline-none">
      </div>
      <button onclick="exportAllDataJSON()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-lg font-semibold flex items-center gap-1.5 transition">
        <i class="fa-solid fa-download"></i> Backup JSON
      </button>
      <label class="bg-sky-700 hover:bg-sky-600 text-white px-3 py-1.5 rounded-lg font-semibold flex items-center gap-1.5 cursor-pointer transition">
        <i class="fa-solid fa-upload"></i> Restore JSON
        <input type="file" accept=".json" onchange="importAllDataJSON(event)" class="hidden">
      </label>
      <button onclick="resetDemoData()" class="bg-rose-700 hover:bg-rose-600 text-white px-3 py-1.5 rounded-lg font-semibold flex items-center gap-1.5 transition" title="Reset data ke contoh awal">
        <i class="fa-solid fa-rotate-left"></i> Reset
      </button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <nav class="bg-teal-950/70 border-t border-teal-800 px-4 py-2 overflow-x-auto custom-scroll">
    <div class="max-w-[1440px] mx-auto flex items-center gap-1.5 min-w-max">
      <button onclick="switchMainTab('nilai')" id="tab-nilai" class="tab-btn active px-3.5 py-2 rounded-lg text-xs font-bold flex items-center gap-2 transition">
        <i class="fa-solid fa-table-list"></i> Input Nilai &amp; Katrol
      </button>
      <button onclick="switchMainTab('legger')" id="tab-legger" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold text-teal-100 hover:bg-teal-800/60 flex items-center gap-2 transition">
        <i class="fa-solid fa-award"></i> Legger Nilai &amp; Ranking
      </button>
      <button onclick="switchMainTab('kalender')" id="tab-kalender" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold text-teal-100 hover:bg-teal-800/60 flex items-center gap-2 transition">
        <i class="fa-solid fa-calendar-days"></i> Kalender Pendidikan
      </button>
      <button onclick="switchMainTab('perangkat')" id="tab-perangkat" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold text-teal-100 hover:bg-teal-800/60 flex items-center gap-2 transition">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Perangkat Pembelajaran (AI)
      </button>
      <button onclick="switchMainTab('butir')" id="tab-butir" class="tab-btn px-3.5 py-2 rounded-lg text-xs font-bold text-teal-100 hover:bg-teal-800/60 flex items-center gap-2 transition">
        <i class="fa-solid fa-square-poll-vertical"></i> Analisis Butir Soal &amp; Kisi-Kisi
      </button>
    </div>
  </nav>
</header>

<main class="max-w-[1440px] mx-auto px-4 py-5 space-y-5">

  <!-- ===================================================================== -->
  <!-- TAB 1: INPUT NILAI, KKTP (DEFAULT 70) & KATROL NILAI ADIL           -->
  <!-- ===================================================================== -->
  <section id="section-nilai" class="space-y-4">
    <!-- Control & KKTP / Katrol Panel -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 no-print">
      <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100">
        <div>
          <h2 class="text-base font-extrabold text-slate-800 flex items-center gap-2">
            <span class="w-2.5 h-6 bg-teal-600 rounded-full inline-block"></span>
            Input Nilai Tugas/Ulangan &amp; ASAS/ASAT (26 Siswa)
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Aturan otomatis: Nilai input &lt; <span id="kktpBadgeText" class="font-bold text-teal-700">70</span> otomatis disesuaikan menjadi <span id="kktpBadgeVal" class="font-bold text-teal-700">70</span> (karena input dilakukan setelah tuntas). Kosongkan bila belum ada nilai.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <label class="text-xs font-bold text-slate-600">Mata Pelajaran:</label>
          <select id="nilaiMapelSelect" onchange="renderNilaiTable()" class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-800 focus:ring-2 focus:ring-teal-500">
          </select>
          <button onclick="openMateriLabelModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5">
            <i class="fa-solid fa-tag"></i> Label Materi Tugas 1–10
          </button>
          <button onclick="exportNilaiExcel()" class="bg-teal-700 hover:bg-teal-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5">
            <i class="fa-solid fa-file-excel"></i> Export XLSX
          </button>
        </div>
      </div>

      <!-- KKTP & Katrol Nilai / Dongkrak Nilai Logis & Adil -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 pt-4">
        <!-- KKTP Config -->
        <div class="lg:col-span-4 bg-teal-50/70 border border-teal-200 rounded-xl p-3.5 space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-teal-900 uppercase tracking-wide">
              <i class="fa-solid fa-shield-check mr-1"></i> Ketuntasan Minimal (KKTP)
            </span>
            <span class="text-[11px] bg-teal-200/70 text-teal-900 px-2 py-0.5 rounded-full font-bold">Default: 70</span>
          </div>
          <p class="text-[11px] text-teal-800 leading-relaxed">
            Dalam Kurikulum Merdeka disebut <strong>KKTP</strong> (Kriteria Ketercapaian Tujuan Pembelajaran) / batas ketuntasan minimal. Nilai yang diketik di bawah batas ini otomatis naik ke batas minimal saat disimpan/diblur.
          </p>
          <div class="flex items-center gap-2">
            <input type="number" id="kktpInputBox" min="1" max="100" value="70"
              class="w-20 bg-white border border-teal-300 rounded-lg px-2.5 py-1.5 text-xs font-extrabold text-teal-900">
            <button onclick="applyKktpAndClampAll()" class="bg-teal-700 hover:bg-teal-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold transition">
              Terapkan &amp; Sesuaikan Nilai
            </button>
          </div>
        </div>

        <!-- Katrol / Dongkrak Nilai Logis & Adil -->
        <div class="lg:col-span-8 bg-amber-50/70 border border-amber-200 rounded-xl p-3.5 space-y-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-extrabold text-amber-950 uppercase tracking-wide">
              <i class="fa-solid fa-scale-balanced mr-1"></i> Fitur Katrol / Dongkrak Nilai (Logis &amp; Adil)
            </span>
            <span class="text-[11px] text-amber-900 font-semibold">Menggunakan fungsi kompresi proporsional (batas atas 100, menjaga urutan ranking)</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-4 gap-2 items-end">
            <div>
              <label class="block text-[11px] font-bold text-amber-900 mb-1">Target Komponen</label>
              <select id="katrolTarget" class="w-full bg-white border border-amber-300 rounded-lg px-2 py-1.5 text-xs font-bold">
                <option value="tugas">Semua Tugas/Ulangan (Mapel ini)</option>
                <option value="asas">Nilai ASAS/ASAT (Mapel ini)</option>
                <option value="both">Tugas &amp; ASAS/ASAT (Mapel ini)</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-amber-900 mb-1">Metode Katrol Adil</label>
              <select id="katrolMethod" class="w-full bg-white border border-amber-300 rounded-lg px-2 py-1.5 text-xs font-bold">
                <option value="linear_cap">Linear Terbatas (Max 100)</option>
                <option value="proportional_gap">Kompresi Sisa Gap (Adil ke Nilai Tinggi)</option>
                <option value="target_floor">Angkat Rata-Rata ke Batas</option>
              </select>
            </div>
            <div>
              <label class="block text-[11px] font-bold text-amber-900 mb-1">Besar Poin / Target</label>
              <input type="number" id="katrolValue" step="0.5" value="5" min="0" max="30"
                class="w-full bg-white border border-amber-300 rounded-lg px-2.5 py-1.5 text-xs font-extrabold">
            </div>
            <div class="flex gap-1.5">
              <button onclick="previewKatrol()" class="flex-1 bg-amber-600 hover:bg-amber-500 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold">
                Simulasi
              </button>
              <button onclick="applyKatrol()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-white px-2.5 py-1.5 rounded-lg text-xs font-bold">
                Terapkan
              </button>
            </div>
          </div>
          <div id="katrolPreviewBox" class="text-[11px] text-amber-950 bg-white/80 rounded-lg px-3 py-2 border border-amber-200 hidden"></div>
        </div>
      </div>
    </div>

    <!-- Nilai Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
      <div class="overflow-x-auto custom-scroll">
        <table class="w-full text-xs border-collapse" id="nilaiInputTable">
          <thead>
            <tr class="bg-slate-800 text-white text-center">
              <th class="p-2.5 border border-slate-700 w-10 sticky left-0 bg-slate-800 z-10">No</th>
              <th class="p-2.5 border border-slate-700 min-w-[180px] text-left sticky left-10 bg-slate-800 z-10">Nama Siswa (26)</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 1">T1</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 2">T2</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 3">T3</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 4">T4</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 5">T5</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 6">T6</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 7">T7</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 8">T8</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 9">T9</th>
              <th class="p-2 border border-slate-700 w-14" title="Tugas/Ulangan 10">T10</th>
              <th class="p-2 border border-slate-700 bg-teal-900 w-16">Rata Tugas</th>
              <th class="p-2 border border-slate-700 bg-indigo-900 w-16">ASAS / ASAT</th>
              <th class="p-2 border border-slate-700 bg-emerald-900 w-16">Nilai Akhir</th>
            </tr>
          </thead>
          <tbody id="nilaiTableBody"></tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- TAB 2: LEGGER NILAI & RANKING (3 JENIS LEGGER)                        -->
  <!-- ===================================================================== -->
  <section id="section-legger" class="hidden space-y-4">
    <!-- Sub-tabs & Controls -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-4 space-y-4 no-print">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap gap-2">
          <button onclick="switchLeggerType('tugas')" id="subtab-tugas" class="subtab-btn active px-3.5 py-2 rounded-lg text-xs font-bold transition">
            1. Legger Rata-Rata Tugas (Tanpa ASAS/ASAT)
          </button>
          <button onclick="switchLeggerType('asas')" id="subtab-asas" class="subtab-btn px-3.5 py-2 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
            2. Legger Nilai ASAS / ASAT
          </button>
          <button onclick="switchLeggerType('rapor')" id="subtab-rapor" class="subtab-btn px-3.5 py-2 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
            3. Legger Rapor (Rata-Rata Tugas + ASAS/ASAT)
          </button>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="toggleSortLegger()" id="btnSortLegger" class="bg-amber-600 hover:bg-amber-500 text-white px-3.5 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5 shadow-sm transition">
            <i class="fa-solid fa-arrow-down-1-9"></i> Urutkan Rank 1 → 26
          </button>
          <button onclick="exportCurrentLeggerXLSX()" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3.5 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5">
            <i class="fa-solid fa-file-excel"></i> Export XLSX
          </button>
          <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-white px-3.5 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5">
            <i class="fa-solid fa-print"></i> Cetak / PDF
          </button>
        </div>
      </div>

      <!-- Dropdown Materi Khusus Legger Tugas -->
      <div id="leggerMateriFilterBar" class="flex flex-wrap items-center justify-between gap-3 bg-teal-50 border border-teal-200 rounded-xl px-4 py-2.5">
        <div class="flex flex-wrap items-center gap-2">
          <label for="leggerMateriSelect" class="text-xs font-extrabold text-teal-900">
            <i class="fa-solid fa-filter mr-1"></i> Pilih Materi / Tugas Ke-:
          </label>
          <select id="leggerMateriSelect" onchange="renderLegger()" class="bg-white border border-teal-300 rounded-lg px-3 py-1.5 text-xs font-bold text-slate-800">
            <option value="all">Semua Materi yang Sudah Diisi (Rata-Rata Keseluruhan)</option>
          </select>
        </div>
        <span class="text-[11px] text-teal-800 font-medium">
          *Dropdown hanya menampilkan slot Tugas/Materi yang minimal sudah memiliki nilai terisi pada salah satu mapel.
        </span>
      </div>

      <!-- Identitas Kepala Sekolah & Wali Kelas (Tanggal dikosongkan untuk diisi manual sebelum ekspor/cetak) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs">
        <div>
          <label class="block font-bold text-slate-600 mb-1">Nama Satuan Pendidikan / Kelas</label>
          <input id="metaSekolah" type="text" value="MIM 1 Slinga — Kelas III (3)" oninput="syncTtdLabels()"
            class="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 font-semibold">
        </div>
        <div>
          <label class="block font-bold text-slate-600 mb-1">Nama Kepala Madrasah / Sekolah</label>
          <input id="metaKepsek" type="text" value="Kepala Madrasah, S.Pd.I" oninput="syncTtdLabels()"
            class="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 font-semibold">
        </div>
        <div>
          <label class="block font-bold text-slate-600 mb-1">Nama Wali Kelas III</label>
          <input id="metaWalikelas" type="text" value="Wali Kelas 3, S.Pd." oninput="syncTtdLabels()"
            class="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 font-semibold">
        </div>
      </div>
    </div>

    <!-- Printable Legger Sheet -->
    <div id="leggerPrintable" class="print-container bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
      <div class="text-center border-b-2 border-slate-800 pb-3">
        <h2 id="leggerTitle" class="text-lg font-extrabold uppercase tracking-wide text-slate-900">
          LEGGER RATA-RATA NILAI TUGAS SEMUA MATA PELAJARAN (TANPA ASAS/ASAT)
        </h2>
        <p id="leggerSubtitle" class="text-xs font-semibold text-slate-600 mt-0.5">
          MIM 1 Slinga — Kelas III (3) | Filter: Semua Materi Terisi | KKTP: 70
        </p>
      </div>

      <div class="overflow-x-auto custom-scroll">
        <table class="w-full text-xs border-collapse" id="leggerTable">
          <thead id="leggerThead"></thead>
          <tbody id="leggerTbody"></tbody>
        </table>
      </div>

      <!-- Kolom Tanda Tangan Kepala Sekolah & Wali Kelas (Tanggal Bulan Tahun kosong untuk diisi manual) -->
      <div class="pt-6 grid grid-cols-2 gap-8 text-xs text-slate-800 break-inside-avoid">
        <div class="flex flex-col items-center text-center">
          <p class="font-semibold">Mengetahui,</p>
          <p class="font-bold mt-0.5">Kepala Madrasah / Sekolah</p>
          <div class="h-20"></div>
          <p id="ttdKepsekName" class="font-extrabold underline decoration-slate-400">Kepala Madrasah, S.Pd.I</p>
          <p class="text-[11px] text-slate-500">NIP. ........................................</p>
        </div>

        <div class="flex flex-col items-center text-center">
          <p class="font-semibold">
            <span class="inline-block min-w-[90px] border-b border-dotted border-slate-600">&nbsp;</span>,
            <span class="inline-block min-w-[36px] border-b border-dotted border-slate-600">&nbsp;</span>
            <span class="inline-block min-w-[80px] border-b border-dotted border-slate-600">&nbsp;</span>
            <span class="inline-block min-w-[48px] border-b border-dotted border-slate-600">&nbsp;</span>
          </p>
          <p class="font-bold mt-0.5">Wali Kelas III</p>
          <div class="h-20"></div>
          <p id="ttdWalikelasName" class="font-extrabold underline decoration-slate-400">Wali Kelas 3, S.Pd.</p>
          <p class="text-[11px] text-slate-500">NIP. ........................................</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- TAB 3: IMPOR KALENDER PENDIDIKAN (XLSX, DOCX, PDF)                    -->
  <!-- ===================================================================== -->
  <section id="section-kalender" class="hidden space-y-4">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-3">
        <div>
          <h2 class="text-base font-extrabold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-calendar-check text-teal-600"></i> Kalender Pendidikan &amp; Impor Multi-Format (XLSX, DOCX, PDF)
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Unggah file Kalender Pendidikan berformat <strong>.xlsx / .xls / .csv</strong>, <strong>.docx</strong>, atau <strong>.pdf</strong>, atau tambah agenda manual.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <label class="bg-teal-700 hover:bg-teal-600 text-white px-3.5 py-2 rounded-lg text-xs font-bold cursor-pointer flex items-center gap-1.5 transition">
            <i class="fa-solid fa-file-import"></i> Impor File (.xlsx, .docx, .pdf)
            <input id="kaldikFileInput" type="file" accept=".xlsx,.xls,.csv,.docx,.pdf" onchange="handleKaldikImport(event)" class="hidden">
          </label>
          <button onclick="exportKaldikXLSX()" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3.5 py-2 rounded-lg text-xs font-bold flex items-center gap-1.5">
            <i class="fa-solid fa-file-excel"></i> Export XLSX
          </button>
        </div>
      </div>

      <!-- Manual Agenda Form -->
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5 bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs">
        <div>
          <label class="block font-bold text-slate-600 mb-1">Tanggal / Rentang</label>
          <input id="kaldikTanggal" type="text" placeholder="Contoh: 2026-07-13 s.d. 2026-07-18"
            class="w-full bg-white border border-slate-300 rounded-lg px-2.5 py-1.5">
        </div>
        <div>
          <label class="block font-bold text-slate-600 mb-1">Kategori</label>
