function avgArray(arr) {
  const valid = arr.filter(v => v !== null && v !== undefined && !Number.isNaN(Number(v))).map(Number);
  if (!valid.length) return null;
  return valid.reduce((a, b) => a + b, 0) / valid.length;
}

function getStudentMapelSummary(mp, student) {
  const rec = state.scores[mp][student];
  const rataTugas = avgArray(rec.tugas);
  const asas = (rec.asas === null || rec.asas === undefined || rec.asas === '') ? null : Number(rec.asas);

  let nilaiAkhir = null;
  if (rataTugas !== null && asas !== null) {
    // Bobot 60% rata-rata tugas + 40% ASAS/ASAT
    nilaiAkhir = rataTugas * 0.6 + asas * 0.4;
  } else if (rataTugas !== null) {
    nilaiAkhir = rataTugas;
  } else if (asas !== null) {
    nilaiAkhir = asas;
  }

  return { rataTugas, asas, nilaiAkhir };
}

