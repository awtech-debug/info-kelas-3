if (window.pdfjsLib) {
  pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
}

const STORAGE_KEY = 'info_kelas_3_portal_v1';

const DEFAULT_MAPLES = [
  'Bahasa Indonesia',
  'Matematika',
  'IPAS',
  'Pendidikan Pancasila',
  'Seni & Budaya',
  'PJOK',
  'Bahasa Jawa',
  'PAI / Al-Islam'
];

const DEFAULT_STUDENTS = [
  'Ahmad Fauzi', 'Aisyah Zahra', 'Alvaro Pratama', 'Anindya Putri', 'Arkananta Wijaya',
  'Aulia Rahma', 'Bagas Aditya', 'Bilqis Nurul', 'Candra Kirana', 'Daffa Rizky',
  'Dea Maharani', 'Dimas Saputra', 'Elina Safitri', 'Fajar Ramadhan', 'Gita Permata',
  'Hafiz Maulana', 'Inayah Azzahra', 'Jovan Ardiansyah', 'Kayla Novita', 'Luthfi Hakim',
  'Maya Anggraini', 'Naufal Zaki', 'Olivia Kusuma', 'Raka Setiawan', 'Salsabila Hani',
  'Zidan Alfarizi'
];

function createInitialState() {
  const scores = {};
  DEFAULT_MAPLES.forEach((mp, mIdx) => {
    scores[mp] = {};
    DEFAULT_STUDENTS.forEach((st, sIdx) => {
      // Nilai awal realistis >= 70 agar langsung terlihat siap pakai
      const base = 74 + ((sIdx * 3 + mIdx * 5) % 21);
      const t = Array.from({ length: 10 }, (_, i) => {
        if (i < 4) return Math.min(100, Math.max(70, base + ((i + sIdx) % 7) - 2));
        return null; // Tugas 5-10 kosong awal agar dropdown materi cerdas hanya menampilkan yang terisi
      });
      const asas = Math.min(100, Math.max(70, base + ((sIdx + mIdx) % 8) - 2));
      scores[mp][st] = { tugas: t, asas: asas };
    });
  });

  return {
    kktp: 70,
    maples: [...DEFAULT_MAPLES],
    students: [...DEFAULT_STUDENTS],
    materiLabels: Array.from({ length: 10 }, (_, i) => `Materi / Tugas ${i + 1}`),
    scores: scores,
    meta: {
      sekolah: 'MIM 1 Slinga — Kelas III (3)',
      kepsek: 'Kepala Madrasah, S.Pd.I',
      walikelas: 'Wali Kelas 3, S.Pd.'
    },
    kalender: [
      { tanggal: '2026-07-13 s.d. 2026-07-18', kategori: 'Efektif KBM', uraian: 'Awal Tahun Ajaran & Masa Pengenalan Lingkungan' },
      { tanggal: '2026-08-17', kategori: 'Libur Nasional / Cuti', uraian: 'Hari Kemerdekaan Republik Indonesia' },
      { tanggal: '2026-09-21 s.d. 2026-09-26', kategori: 'Asesmen / ASAS / ASAT', uraian: 'Asesmen Sumatif Tengah / Formatif Berkala' },
      { tanggal: '2026-11-30 s.d. 2026-12-05', kategori: 'Asesmen / ASAS / ASAT', uraian: 'Asesmen Sumatif Akhir Semester (ASAS)' },
      { tanggal: '2026-12-19', kategori: 'Rapor / Jeda Semester', uraian: 'Pembagian Laporan Hasil Belajar (Rapor)' }
    ],
    geminiKey: '',
    butirSoal: [
      { no: 1, tipe: 'PG', indikator: 'Menentukan nilai tempat bilangan cacah', soal: 'Nilai angka 8 pada bilangan 834 adalah...', kunci: 'A (800)', skorMax: 1 },
      { no: 2, tipe: 'PG Kompleks', indikator: 'Mengidentifikasi wujud benda', soal: 'Pilih benda yang berwujud cair (lebih dari satu)!', kunci: 'Air, Minyak goreng', skorMax: 2 },
      { no: 3, tipe: 'Menjodohkan', indikator: 'Menghubungkan simbol Pancasila dengan makna', soal: 'Pasangkan simbol Sila ke-2 dan ke-3 dengan maknanya.', kunci: '2-Kemanusiaan, 3-Persatuan', skorMax: 2 },
      { no: 4, tipe: 'Isian Singkat', indikator: 'Menyelesaikan operasi penjumlahan', soal: 'Hasil dari 245 + 135 adalah...', kunci: '380', skorMax: 2 },
      { no: 5, tipe: 'Uraian', indikator: 'Menjelaskan cara merawat lingkungan sekolah', soal: 'Tuliskan 2 cara menjaga kebersihan kelas!', kunci: 'Piket rutin, buang sampah pada tempatnya', skorMax: 3 }
    ],
    butirSkorSiswa: {}
  };
}

let state = loadState();

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return createInitialState();
    const parsed = JSON.parse(raw);
    const init = createInitialState();
    return {
      ...init,
      ...parsed,
      kktp: Number(parsed.kktp) || 70,
      meta: { ...init.meta, ...(parsed.meta || {}) },
      scores: parsed.scores || init.scores,
      kalender: Array.isArray(parsed.kalender) ? parsed.kalender : init.kalender,
      butirSoal: Array.isArray(parsed.butirSoal) ? parsed.butirSoal : init.butirSoal,
      butirSkorSiswa: parsed.butirSkorSiswa || {}
    };
  } catch (e) {
    console.error('Load state error:', e);
    return createInitialState();
  }
}

function saveState() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  } catch (e) {
    console.warn('Storage full or restricted:', e);
  }
}

