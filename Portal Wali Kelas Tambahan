  }
}

function computeLeggerRows() {
  const materiFilter = document.getElementById('leggerMateriSelect').value;

  const rows = state.students.map((student, originalIdx) => {
    const perMapel = {};
    let total = 0;
    let countValidMapel = 0;

    state.maples.forEach(mp => {
      const rec = state.scores[mp][student];
      let val = null;

      if (currentLeggerType === 'tugas') {
        if (materiFilter === 'all') {
          val = avgArray(rec.tugas);
        } else {
          const mIdx = Number(materiFilter);
          const v = rec.tugas[mIdx];
          val = (v !== null && v !== undefined && v !== '') ? Number(v) : null;
        }
      } else if (currentLeggerType === 'asas') {
        val = (rec.asas === null || rec.asas === undefined || rec.asas === '') ? null : Number(rec.asas);
      } else if (currentLeggerType === 'rapor') {
        const sum = getStudentMapelSummary(mp, student);
        val = sum.nilaiAkhir;
      }

      perMapel[mp] = val;
      if (val !== null && !Number.isNaN(val)) {
        total += val;
        countValidMapel++;
      }
    });

    const rata = countValidMapel > 0 ? total / countValidMapel : null;
    return {
      originalNo: originalIdx + 1,
      student,
      perMapel,
      jumlah: countValidMapel > 0 ? total : null,
      rata: rata,
      rank: null
    };
  });

  // Hitung ranking (nilai rata-rata / jumlah tertinggi = Rank 1)
  const sortedForRank = [...rows].sort((a, b) => (b.rata ?? -1) - (a.rata ?? -1));
  sortedForRank.forEach((item, idx) => {
    item.rank = item.rata !== null ? idx + 1 : '-';
  });

  if (isLeggerSortedByRank) {
    return [...rows].sort((a, b) => {
      const ra = typeof a.rank === 'number' ? a.rank : 999;
      const rb = typeof b.rank === 'number' ? b.rank : 999;
      return ra - rb;
    });
  }
  return rows;
}

function toggleSortLegger() {
