// =========================================================================
// TAB 5: ANALISIS BUTIR SOAL, KUNCI JAWABAN & KISI-KISI
// =========================================================================
const TIPE_SOAL_OPTIONS = ['PG', 'PG Kompleks', 'Menjodohkan', 'Isian Singkat', 'Uraian'];

function ensureButirScoresInitialized() {
  state.students.forEach(st => {
    if (!Array.isArray(state.butirSkorSiswa[st])) {
      state.butirSkorSiswa[st] = [];
    }
    while (state.butirSkorSiswa[st].length < state.butirSoal.length) {
      const bIdx = state.butirSkorSiswa[st].length;
      const maxS = Number(state.butirSoal[bIdx]?.skorMax) || 1;
      state.butirSkorSiswa[st].push(maxS);
    }
    if (state.butirSkorSiswa[st].length > state.butirSoal.length) {
      state.butirSkorSiswa[st] = state.butirSkorSiswa[st].slice(0, state.butirSoal.length);
    }
  });
}

function addButirSoalRow() {
  const nextNo = state.butirSoal.length + 1;
  state.butirSoal.push({
    no: nextNo,
    tipe: 'PG',
    indikator: 'Indikator baru',
    soal: 'Tuliskan butir soal...',
    kunci: 'A',
    skorMax: 1
  });
  ensureButirScoresInitialized();
  saveState();
  renderButirConfig();
  renderButirMatrix();
}

function deleteButirSoalRow(idx) {
  state.butirSoal.splice(idx, 1);
  state.butirSoal.forEach((b, i) => b.no = i + 1);
  state.students.forEach(st => {
    if (Array.isArray(state.butirSkorSiswa[st])) {
      state.butirSkorSiswa[st].splice(idx, 1);
    }
  });
  saveState();
  renderButirConfig();
  renderButirMatrix();
}

function parsePastedKisiSoal() {
  const raw = document.getElementById('pasteKisiInput').value.trim();
  if (!raw) {
    alert('Silakan ketik atau tempelkan kisi-kisi / butir soal terlebih dahulu.');
    return;
  }
  const lines = raw.split(/
?
/).map(l => l.trim()).filter(Boolean);
  const parsed = [];

  lines.forEach((line, idx) => {
    const cols = line.split('|').map(c => c.trim());
    if (cols.length >= 4) {
      const tipeRaw = cols[1] || 'PG';
      const matchedTipe = TIPE_SOAL_OPTIONS.find(t => t.toLowerCase() === tipeRaw.toLowerCase()) || tipeRaw;
      parsed.push({
        no: Number(cols[0]) || (idx + 1),
        tipe: matchedTipe,
        indikator: cols[2] || '-',
        soal: cols[3] || '-',
        kunci: cols[4] || '-',
        skorMax: Math.max(0.5, Number(cols[5]) || 1)
      });
    }
  });

  if (!parsed.length) {
    alert('Format baris tidak terbaca. Gunakan pemisah tanda pipa (|).');
    return;
  }

  state.butirSoal = parsed;
  state.butirSkorSiswa = {};
  ensureButirScoresInitialized();
  saveState();
  renderButirConfig();
  renderButirMatrix();
  alert(`Berhasil memuat ${parsed.length} butir soal & kisi-kisi.`);
}

async function handleButirImport(event) {
  const file = event.target.files[0];
  if (!file) return;
  try {
    const extracted = await extractTextFromFile(file);
    const items = [];

    if (extracted.type === 'sheet' && extracted.rows.length > 0) {
      extracted.rows.forEach((r, idx) => {
        const vals = Object.values(r).map(v => String(v).trim());
        if (vals.some(Boolean)) {
          items.push({
            no: Number(vals[0]) || (idx + 1),
            tipe: vals[1] || 'PG',
            indikator: vals[2] || '-',
            soal: vals[3] || '-',
            kunci: vals[4] || '-',
            skorMax: Math.max(0.5, Number(vals[5]) || 1)
          });
        }
      });
    } else {
      const lines = (extracted.text || '').split(/
?
/).map(l => l.trim()).filter(Boolean);
      lines.forEach((line, idx) => {
        const cols = line.split('|').map(c => c.trim());
        if (cols.length >= 3) {
          items.push({
            no: Number(cols[0]) || (idx + 1),
            tipe: cols[1] || 'PG',
            indikator: cols[2] || '-',
            soal: cols[3] || cols[2] || '-',
            kunci: cols[4] || '-',
            skorMax: Math.max(0.5, Number(cols[5]) || 1)
          });
        }
      });
    }

    if (items.length > 0) {
      state.butirSoal = items;
      state.butirSkorSiswa = {};
      ensureButirScoresInitialized();
      saveState();
      renderButirConfig();
      renderButirMatrix();
      alert(`Berhasil mengimpor ${items.length} butir soal dari "${file.name}".`);
    } else {
      alert('File terbaca, namun tidak ditemukan baris kisi-kisi berformat terstruktur. Periksa teks yang diekstrak.');
    }
  } catch (err) {
    alert('Gagal mengimpor file butir soal: ' + err.message);
  } finally {
    event.target.value = '';
  }
}

function renderButirConfig() {
  ensureButirScoresInitialized();
  const tbody = document.getElementById('butirConfigBody');
  tbody.innerHTML = '';

  state.butirSoal.forEach((b, idx) => {
    const typeSelectHtml = `
      <select onchange="updateButirField(${idx}, 'tipe', this.value)" class="w-full border border-slate-300 rounded px-1.5 py-1 font-bold bg-white">
        ${TIPE_SOAL_OPTIONS.map(opt => `<option value="${opt}" ${b.tipe === opt ? 'selected' : ''}>${opt}</option>`).join('')}
        ${!TIPE_SOAL_OPTIONS.includes(b.tipe) ? `<option value="${b.tipe}" selected>${b.tipe}</option>` : ''}
      </select>
    `;

    tbody.innerHTML += `
      <tr class="${idx % 2 === 0 ? 'bg-white' : 'bg-slate-50'}">
        <td class="p-1.5 border border-slate-200 text-center font-bold">${b.no}</td>
        <td class="p-1.5 border border-slate-200">${typeSelectHtml}</td>
        <td class="p-1.5 border border-slate-200">
          <input type="text" value="${b.indikator.replace(/"/g, '&quot;')}" onchange="updateButirField(${idx}, 'indikator', this.value)"
            class="w-full border border-slate-300 rounded px-2 py-1">
        </td>
        <td class="p-1.5 border border-slate-200">
          <input type="text" value="${b.soal.replace(/"/g, '&quot;')}" onchange="updateButirField(${idx}, 'soal', this.value)"
            class="w-full border border-slate-300 rounded px-2 py-1">
        </td>
        <td class="p-1.5 border border-slate-200">
          <input type="text" value="${b.kunci.replace(/"/g, '&quot;')}" onchange="updateButirField(${idx}, 'kunci', this.value)"
            class="w-full border border-slate-300 rounded px-2 py-1 font-semibold text-emerald-900">
        </td>
        <td class="p-1.5 border border-slate-200 text-center">
          <input type="number" min="0.5" max="100" step="0.5" value="${b.skorMax}" onchange="updateButirField(${idx}, 'skorMax', Number(this.value) || 1)"
            class="w-16 text-center border border-slate-300 rounded px-1.5 py-1 font-bold">
        </td>
        <td class="p-1.5 border border-slate-200 text-center">
          <button onclick="deleteButirSoalRow(${idx})" class="text-rose-600 hover:text-rose-800 font-bold px-2 py-1">
            <i class="fa-solid fa-trash"></i>
          </button>
        </td>
      </tr>
    `;
  });
}

function updateButirField(idx, field, value) {
  state.butirSoal[idx][field] = value;
  saveState();
  renderButirMatrix();
}

function renderButirMatrix() {
  ensureButirScoresInitialized();
  const thead = document.getElementById('butirMatrixThead');
  const tbody = document.getElementById('butirMatrixTbody');

  const totalMaxSkor = state.butirSoal.reduce((acc, b) => acc + (Number(b.skorMax) || 1), 0);

  let thButir = '';
  state.butirSoal.forEach((b, idx) => {
    thButir += `
      <th class="p-2 border border-slate-700 text-center min-w-[74px]" title="${b.indikator} (Kunci: ${b.kunci})">
        B${b.no}<br><span class="text-[10px] text-amber-300 font-normal">Max ${b.skorMax}</span>
      </th>
    `;
  });

  thead.innerHTML = `
    <tr class="bg-slate-800 text-white">
      <th class="p-2 border border-slate-700 w-10 text-center">No</th>
      <th class="p-2 border border-slate-700 min-w-[160px] text-left">Nama Siswa</th>
      ${thButir}
      <th class="p-2 border border-slate-700 bg-indigo-900 w-16 text-center">Skor</th>
      <th class="p-2 border border-slate-700 bg-teal-900 w-16 text-center">Nilai (0-100)</th>
    </tr>
  `;

  tbody.innerHTML = '';
  state.students.forEach((st, sIdx) => {
    const scoresArr = state.butirSkorSiswa[st];
    let sumSkor = 0;
    let cells = '';

    state.butirSoal.forEach((b, bIdx) => {
      const maxS = Number(b.skorMax) || 1;
      const sc = Math.min(maxS, Math.max(0, Number(scoresArr[bIdx] ?? 0)));
      sumSkor += sc;
      cells += `
        <td class="p-1 border border-slate-200 text-center">
          <input type="number" min="0" max="${maxS}" step="0.5" value="${sc}"
            onchange="onButirStudentScoreChange('${st.replace(/'/g, "\'")}', ${bIdx}, ${maxS}, this.value)"
            class="w-14 text-center border border-slate-200 rounded py-1 font-semibold">
        </td>
      `;
    });

    const nilaiSkala100 = totalMaxSkor > 0 ? (sumSkor / totalMaxSkor) * 100 : 0;
    tbody.innerHTML += `
      <tr class="${sIdx % 2 === 0 ? 'bg-white' : 'bg-slate-50/70'}">
        <td class="p-2 border border-slate-200 text-center font-bold text-slate-500">${sIdx + 1}</td>
        <td class="p-2 border border-slate-200 font-bold text-slate-800">${st}</td>
        ${cells}
        <td class="p-2 border border-slate-200 text-center font-extrabold text-indigo-900">${sumSkor.toFixed(1)}</td>
        <td class="p-2 border border-slate-200 text-center font-extrabold text-teal-900">${nilaiSkala100.toFixed(1)}</td>
      </tr>
    `;
  });

  // Baris Statistik Tingkat Kesukaran / Daya Serap per Butir Soal
  let statCells = '';
  state.butirSoal.forEach((b, bIdx) => {
    const maxS = Number(b.skorMax) || 1;
    const avgButir = state.students.reduce((acc, st) => acc + (Number(state.butirSkorSiswa[st]?.[bIdx]) || 0), 0) / state.students.length;
    const pct = (avgButir / (maxS * state.students.length)) * state.students.length * 100;
    statCells += `
      <td class="p-2 border border-slate-300 text-center font-bold text-indigo-950">
        ${avgButir.toFixed(2)}<br><span class="text-[10px] font-normal text-slate-600">(${pct.toFixed(0)}%)</span>
      </td>
    `;
  });

  tbody.innerHTML += `
    <tr class="bg-indigo-100/80">
      <td colspan="2" class="p-2 border border-slate-300 font-extrabold text-indigo-950">
        Rata-Rata Skor &amp; Daya Serap per Butir
      </td>
      ${statCells}
      <td colspan="2" class="p-2 border border-slate-300 text-center font-bold text-indigo-950">
        Max Skor: ${totalMaxSkor}
      </td>
    </tr>
  `;
}

function onButirStudentScoreChange(student, bIdx, maxS, val) {
  const num = Math.min(maxS, Math.max(0, Number(val) || 0));
  state.butirSkorSiswa[student][bIdx] = num;
  saveState();
  renderButirMatrix();
}

function exportAnalisisButirXLSX() {
  ensureButirScoresInitialized();
  const totalMaxSkor = state.butirSoal.reduce((acc, b) => acc + (Number(b.skorMax) || 1), 0);
  const rows = state.students.map((st, idx) => {
    const obj = { No: idx + 1, 'Nama Siswa': st };
    let sumSkor = 0;
    state.butirSoal.forEach((b, bIdx) => {
      const sc = Number(state.butirSkorSiswa[st]?.[bIdx]) || 0;
      sumSkor += sc;
      obj[`B${b.no} (${b.tipe})`] = sc;
    });
    obj['Total Skor'] = sumSkor;
    obj['Nilai (0-100)'] = totalMaxSkor > 0 ? Number(((sumSkor / totalMaxSkor) * 100).toFixed(2)) : 0;
    return obj;
  });
  const ws = XLSX.utils.json_to_sheet(rows);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'Analisis_Butir_Soal');
  XLSX.writeFile(wb, 'Analisis_Butir_Soal_Kelas3.xlsx');
}

