  state.students.forEach(st => {
    const rec = state.scores[mp][st];
    if (target === 'tugas' || target === 'both') {
      rec.tugas = rec.tugas.map(v => computeKatrolValue(v, method, param, avgCurr));
    }
    if (target === 'asas' || target === 'both') {
      rec.asas = computeKatrolValue(rec.asas, method, param, avgCurr);
    }
  });

  saveState();
  renderNilaiTable();
  previewKatrol();
  alert(`Katrol nilai berhasil diterapkan pada mata pelajaran ${mp}.`);
}

