// =========================================================================
// KKTP (DEFAULT 70) & KATROL NILAI LOGIS & ADIL
// =========================================================================
function clampToKktp(val) {
  if (val === '' || val === null || val === undefined) return null;
  const num = Number(val);
  if (Number.isNaN(num)) return null;
  const bounded = Math.min(100, Math.max(0, num));
  return bounded < state.kktp ? state.kktp : bounded;
}

function updateGlobalKktp(newVal) {
  const k = Math.min(100, Math.max(1, Number(newVal) || 70));
  state.kktp = k;
  document.getElementById('globalKktpInput').value = k;
  document.getElementById('kktpInputBox').value = k;
  document.getElementById('kktpBadgeText').textContent = k;
  document.getElementById('kktpBadgeVal').textContent = k;
  saveState();
  renderNilaiTable();
  if (!document.getElementById('section-legger').classList.contains('hidden')) {
    renderLegger();
  }
}

function applyKktpAndClampAll() {
  const k = Math.min(100, Math.max(1, Number(document.getElementById('kktpInputBox').value) || 70));
  state.kktp = k;
  document.getElementById('globalKktpInput').value = k;
  document.getElementById('kktpBadgeText').textContent = k;
  document.getElementById('kktpBadgeVal').textContent = k;

  state.maples.forEach(mp => {
    state.students.forEach(st => {
      const rec = state.scores[mp][st];
      rec.tugas = rec.tugas.map(v => v === null ? null : clampToKktp(v));
      if (rec.asas !== null && rec.asas !== undefined) {
        rec.asas = clampToKktp(rec.asas);
      }
    });
  });

  saveState();
  renderNilaiTable();
  alert(`KKTP ${k} diterapkan. Seluruh nilai terisi yang di bawah ${k} otomatis disesuaikan menjadi ${k}.`);
}

/**
 * Menghitung nilai katrol secara logis dan adil:
 * - linear_cap: x' = min(100, max(kktp, x + bonus))
 * - proportional_gap: siswa dengan nilai lebih rendah mendapat dorongan lebih besar pada sisa gap menuju 100,
 *   sehingga tidak menabrak plafon 100 terlalu cepat dan tetap adil serta menjaga urutan ranking.
 * - target_floor: mengangkat rata-rata kelas/mapel mendekati target secara proporsional.
 */
function computeKatrolValue(rawVal, method, param, avgCurrent) {
  if (rawVal === null || rawVal === undefined || Number.isNaN(Number(rawVal))) return null;
  let x = clampToKktp(Number(rawVal));
  let result = x;

  if (method === 'linear_cap') {
    result = x + param;
  } else if (method === 'proportional_gap') {
    // param dalam persen kompresi (misal 25% menutup sisa jarak ke 100)
    const ratio = Math.min(0.9, Math.max(0, param / 100));
    const gap = Math.max(0, 100 - x);
    result = x + gap * ratio;
  } else if (method === 'target_floor') {
    // param = target rata-rata yang diinginkan (misal 82)
    const lift = Math.max(0, param - avgCurrent);
    result = x + lift;
  }

  result = Math.min(100, Math.max(state.kktp, result));
  return Math.round(result * 10) / 10;
}

function getMapelAverageForKatrol(mp, target) {
  const vals = [];
  state.students.forEach(st => {
    const rec = state.scores[mp][st];
    if (target === 'tugas' || target === 'both') {
      rec.tugas.forEach(v => { if (v !== null) vals.push(v); });
    }
    if (target === 'asas' || target === 'both') {
      if (rec.asas !== null && rec.asas !== undefined) vals.push(rec.asas);
    }
  });
  if (!vals.length) return state.kktp;
  return vals.reduce((a, b) => a + b, 0) / vals.length;
}

function previewKatrol() {
  const mp = document.getElementById('nilaiMapelSelect').value;
  const target = document.getElementById('katrolTarget').value;
