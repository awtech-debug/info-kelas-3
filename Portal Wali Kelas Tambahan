function downloadPerangkatDoc() {
  const jenis = document.getElementById('perangkatJenis').value;
  const mapel = document.getElementById('perangkatMapel').value;
  const content = document.getElementById('perangkatOutput').value || '';
  const htmlDoc = `<html><head><meta charset="utf-8"></head><body><pre style="font-family:Calibri,sans-serif;white-space:pre-wrap;">${content.replace(/</g, '&lt;')}</pre></body></html>`;
  const blob = new Blob([htmlDoc], { type: 'application/msword' });
