async function generatePerangkatPembelajaran() {
  const jenis = document.getElementById('perangkatJenis').value;
  const mapel = document.getElementById('perangkatMapel').value;
  const topik = document.getElementById('perangkatTopik').value.trim() || 'Materi Pokok Semester';
  const apiKey = (document.getElementById('geminiApiKey').value || state.geminiKey || '').trim();
  const outEl = document.getElementById('perangkatOutput');
  const btn = document.getElementById('btnGeneratePerangkat');

  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Sedang Menyusun...';

  const promptText = `Buatkan dokumen "${jenis}" lengkap untuk Kelas 3 SD/MI (Kurikulum Merdeka, KKTP ${state.kktp}) pada mata pelajaran "${mapel}" dengan topik/materi "${topik}" di satuan pendidikan "${state.meta.sekolah}". Susun secara sistematis, jelas, dan siap digunakan guru.`;

  if (!apiKey) {
    // Fallback terstruktur lokal bila API Key belum diisi
    outEl.value = [
      `====================================================================`,
      `${jenis.toUpperCase()} — KURIKULUM MERDEKA`,
      `Satuan Pendidikan : ${state.meta.sekolah}`,
      `Kelas / Fase     : III (3) / Fase B`,
      `Mata Pelajaran   : ${mapel}`,
      `Topik / Materi   : ${topik}`,
      `KKTP Minimal     : ${state.kktp}`,
      `====================================================================`,
      ``,
      `1. TUJUAN PEMBELAJARAN`,
      `   Peserta didik mampu memahami, menerapkan, dan mengomunikasikan konsep "${topik}" pada mata pelajaran ${mapel} dengan tepat dan mandiri.`,
      ``,
      `2. LANGKAH-LANGKAH KEGIATAN PEMBELAJARAN`,
      `   a. Pendahuluan (15 menit): Apersepsi, doa, pemantik terkait "${topik}", dan penyampaian tujuan.`,
      `   b. Kegiatan Inti (45 menit): Eksplorasi konsep, diskusi kelompok/praktik, dan penguatan pemahaman.`,
      `   c. Penutup (10 menit): Refleksi terbimbing, kesimpulan bersama, dan tindak lanjut/asesmen.`,
      ``,
      `3. ASESMEN & KRITERIA KETERCAPAIAN (KKTP: ${state.kktp})`,
      `   - Formatif: Observasi keaktifan & LKPD/Tugas.`,
      `   - Sumatif: Tes tertulis / unjuk kerja sesuai indikator (batas tuntas minimal ${state.kktp}).`,
      ``,
      `Catatan: Masukkan Gemini API Key di kolom atas untuk generate otomatis penuh melalui model Gemini AI.`
    ].join('
');
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-sparkles"></i> Generate Perangkat Pembelajaran';
    return;
  }

  try {
    const resp = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: promptText }] }]
        })
      }
    );
    const data = await resp.json();
    if (!resp.ok) {
      throw new Error(data.error?.message || 'Respons Gemini API gagal.');
    }
    const generated = data.candidates?.[0]?.content?.parts?.map(p => p.text).join('
') || 'Tidak ada teks dihasilkan.';
    outEl.value = generated;
  } catch (err) {
    alert('Error Gemini AI: ' + err.message);
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="fa-solid fa-sparkles"></i> Generate Perangkat Pembelajaran';
  }
}

function copyPerangkatText() {
